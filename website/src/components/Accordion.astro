---
import '../styles/components/_accordion.scss';
const { title, startCollapsed=false } = Astro.props;
---

<!-- back-to-top button -->
<button type="button" class=`accordion__btn ${startCollapsed && 'start_collapsed'}` >
    <div class="accordion__title">{title}</div>
</button>
<div class="accordion__panel">
    <div class="accordion-content">
        <slot />
    </div>
</div>

<!-- Scripts -->
<script src="../scripts/components/accordion"></script>