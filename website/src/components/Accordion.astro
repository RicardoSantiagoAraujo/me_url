---
import '@/styles/components/_accordion.scss';
const { title,  href=null, startCollapsed=false , tooltip=null, tooltipPlacement=null, refreshOnOpen=false } = Astro.props as {
  title: string;
  href?: string | null;
  startCollapsed?: boolean;
  tooltip?: string | null;
  tooltipPlacement?: "top" | "bottom" | "left" | "right" | null;
  refreshOnOpen?: boolean;
};
---

<!-- back-to-top button -->
<button type="button" class=`accordion__btn ${startCollapsed && 'start_collapsed'}` >
    <a class="accordion__title" href={href} data-tooltip={tooltip}  data-tippy-placement={tooltipPlacement}>{title}</a>
</button>
<div class="accordion__panel" style={refreshOnOpen ? "display:none" : ""}>
    <div class="accordion-content" >
        <slot />
    </div>
</div>

<!-- Scripts -->
<script src="../scripts/components/accordion"></script>

<style>
    .accordion__title{
        text-transform: capitalize;
        color: black;
        text-decoration: none;
    }
</style>