---
import '@/styles/components/_accordion.scss';
const { title,  href=null, startCollapsed=false , tooltip=null, tooltipPlacement=null } = Astro.props;
---

<!-- back-to-top button -->
<button type="button" class=`accordion__btn ${startCollapsed && 'start_collapsed'}` >
    <a class="accordion__title" href={href} data-tooltip={tooltip}  data-tippy-placement={tooltipPlacement}>{title}</a>
</button>
<div class="accordion__panel">
    <div class="accordion-content">
        <slot />
    </div>
</div>

<!-- Scripts -->
<script src="../scripts/components/accordion"></script>

<style>
    .accordion__title{
        text-transform: capitalize;
        color: black;
        text-decoration: none;
    }
</style>