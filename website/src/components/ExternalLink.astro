---
const { name, icon, faIcon, address, height } = Astro.props;
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const imagePath = icon;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,svg}')
---
<a class="external-link" href={`https://www.${address}`} data-tooltip={`Go to ${name} at www.${address}`}>
  {icon !== null ? <Image class="external-link-icon" src={images[imagePath]()}  alt={`icon for ${name}`}/> : null}
  {faIcon !== null ? <span class={`external-link-faicon fa ${faIcon}`}></span> : null}
  <span class="external-link-text">{name}</span>
</a>

<style  lang="scss" define:vars={{ height }}>
    @use 'sass:color';
    @use '@/styles/variables/colors' as c;
    a.external-link {
      display: flex;
      align-items: center;
      justify-content: center;
      // padding: 0.5rem 0.5rem;
      // min-width: 125px;
      height: 39px;
      aspect-ratio: 1/1;
      border-radius: 50%;
      color: rgb(0, 0, 0);
      background-color: color.scale(c.$color-white, $alpha: -60%);
      font-size: x-large;
      &:hover {
        background-color: color.scale(c.$color-white, $alpha: -30%);
      transition: 0.2s ease-in-out;

      }
      &:active {
        background-color: color.scale(c.$color-white, $alpha: -0%);
        transition: 0.05s ease-in-out;
      }
      text-decoration: none;
      .external-link-icon {
        height:  calc(var(--height) * 0.8);
        width: auto;
      }
      .external-link-faicon {
        // display: none;
      }
      .external-link-text {
        display: none;
      }
    }

    @media screen and (min-width: 636px) {
      a.external-link {
      // min-width: 150px;
      padding: 0.45rem;
      .external-link-icon {
        height: var(--height);
        width: auto;
      }
      }

  }

</style>