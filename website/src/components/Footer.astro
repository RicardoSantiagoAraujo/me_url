---
import ExternalLink from './ExternalLink.astro';
import instagramIcon from '../assets/icons/instagram.svg';
import { generalParameters } from '../data/general';
---



<footer>
  <!-- FOOTER ROW 1 -->
    <div class="footer_row footer__row1">
      <a href={generalParameters.email}><i class="fa fa-envelope"></i>{generalParameters.email}</a>
      <div class="external-link__container">
        <ExternalLink platform="linkedIn" height="27px" icon={null} faIcon={"fa-brands fa-linkedin"} address={"https://www.linkedin.com/in/ricardo-santiago-araujo/"} />
        <ExternalLink platform="gitHub" height="27px" icon={null} faIcon={"fa-brands fa-github"} address={"https://github.com/RicardoSantiagoAraujo"} />
        <ExternalLink platform="researchGate" height="27px" icon={null} faIcon={"fa-brands fa-researchgate"} address={"https://www.researchgate.net/profile/Ricardo-Santiago-Araujo"} />
        <!-- <ExternalLink platform="instagram" height="7px" icon={instagramIcon} faIcon={"fa-instagram"} address={"instagram.com"} /> -->
      </div>
      <a href="https://maps.app.goo.gl/8jWCija68AREpJKh6"><i class="fa fa-home"></i> {generalParameters.address} </a>
    </div>
    <!-- FOOTER ROW 2 -->
    <div class="footer_row footer__row2">
      <div class="copyright">© Port.jects template website built with Astro by by Ricardo Santiago Araûjo.</div>
    </div>
</footer>