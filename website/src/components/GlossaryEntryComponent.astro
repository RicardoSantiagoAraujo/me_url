G---
import '@/styles/variables/_colors.scss';
import { Icon } from 'astro-icon/components'
import { generalParameters } from '@/data/base/_general';
import { getLangFromUrl } from "@/i18n/utils";
import { glossaries } from '@/content.config';  
const lang : string = getLangFromUrl(Astro.url);

const { entry_id, collectionName, glossaryType, showTooltip=true } = Astro.props as {
  entry_id: string;
  collectionName: string;
  glossaryType: keyof typeof glossaries;
  showTooltip?: boolean;
};

const color="white";
const colorHover="red";
const colorActive="blue";

const entry = (generalParameters as any)[glossaryType][entry_id]; 
--- 
<div class="glossary-entry__container">
    <a href={`/${lang}/${glossaryType}/${collectionName}/${entry_id}`}
    data-tooltip={showTooltip ? (entry.description ? entry.description : null) : null}>
        {entry.name}
    </a>
</div>


<style define:vars={{ color, colorHover, colorActive}}>
</style>


<script>
</script>