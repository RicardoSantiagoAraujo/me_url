---
import { languages, type Language } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath ,translateRoute} from '@/i18n/utils';
const url = Astro.url;
const pathname = url.pathname;
const pathnameWithoutLang = pathname.replace(`/${getLangFromUrl(url)}`, ''); // Remove the current language from the path
const pathElements = pathnameWithoutLang.split('/').filter(Boolean); // Split the path and remove empty segments
const firstElement = pathElements.shift()!; // Remove the first element from the path elements
const currentLang = getLangFromUrl(url);
const translatedPaths = Object.entries(languages)
.filter(([key, value]) => value.isAvailable) // include only available languages
.map(([lang, obj]) => ({
  lang,
  flag: obj.flag,
  path:  `/${lang}/${translateRoute(firstElement, currentLang, lang as Language)}/${pathElements.join("/")}` // Translate the path to the target language
}));
---

<div id="language-select__container">
<label for="language-select"></label>
<select id="language-select" name="language" onchange="window.location.href=this.value">
  {translatedPaths.map(({ lang, flag, path }) => (
    <option value={path} data-lang={lang}>
      {flag}
    </option>
  ))}
</select>
</div>


<style>
  #language-select {
    background: none;
    /* margin: 60% 0%; */
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }
  label{
    display: none;
  }
</style>

<script define:vars={{currentLang}}>
  const selectElement = document.querySelector('#language-select'); // Set the selected value based on the current language

  // Loop through the options and set the matching one as selected
  for (const option of Array.from(selectElement.options)) {
    if (option.dataset.lang === currentLang) {
      option.selected = true;
      break;
    }
  }
</script>