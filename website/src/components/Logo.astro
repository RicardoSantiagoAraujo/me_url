---
import '../styles/variables/_colors.scss';
import { Image } from 'astro:assets';
import logoImg from '../assets/generic_portrait.svg';
import { generalParameters } from '../data/general';
const color="white";
const colorHover="red";
const colorActive="blue";
---

<div class="logo__container">
    <a href="/" class="logo">
        <!-- <div class="logo__img"></div> -->
        <Image class="logo__img" src={logoImg} alt="Logo image."/>
    </a>
</div>


<style define:vars={{ color, colorHover, colorActive}}>
    .logo__container {
        height: 100%;
        aspect-ratio: 1;
    }

    .logo {
        height: 100%;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        .logo__img{
            height: 93%;
            aspect-ratio: 1 / 1;
            width: auto;
            background: var(--color);
            /* background-position: center;
            background-repeat: no-repeat; */
            /* background-size: 97%; */
            border-radius: 50%;
            padding: 3px;
            opacity: 1;
            &:hover{
                transform: scale(1.01);
                transition: all 0.3s ease-in-out;
                background: var(--colorHover);
            }
            &:active{
                transform: scale(1.01);
                transition: all 0.05s ease-in-out;
                background: var(--colorActive);
            }
    }
    }


</style>


