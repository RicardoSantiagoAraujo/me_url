---
import { Image } from 'astro:assets';
const { image, parallaxEffect = "0.3",parallaxHeight = "33vh", parallaxBgColor = "white" , parallaxOpacity = 1, parallaxVerticalAdjustment = 0} = Astro.props as {
  image: string;
  parallaxEffect?: number;
  parallaxHeight?: string;
  parallaxBgColor?: string;
  parallaxOpacity?: number;
  parallaxVerticalAdjustment?: string;
};
---


<div class="parallax__container">
    <div class="parallax__image">
      <Image src={image} alt="Logo image." width="1" height="1" />
    </div>
    <div class="parallax__content">
      <slot />
    </div>
  </div>



  <style define:vars={{ parallaxHeight, parallaxBgColor, parallaxEffect, parallaxOpacity, parallaxVerticalAdjustment}}>

    /* In your global CSS file or component style block */
  .parallax__container {
    background-color: var(--parallaxBgColor);
    height: var(--parallaxHeight);
    margin: auto;
    overflow: hidden;
    position: relative;
    z-index: 0;
  }

  .parallax__image {
    position: absolute;
    transition: 0.01s ease-in-out;
    top: calc(50% + var(--parallaxVerticalAdjustment));
    left: 0;
    width: 100%;
    height:  calc(var(--parallaxHeight));
    transform: translateZ(0)translateY(-50%); /* Avoid paint issues on some browsers */
    will-change: transform;
    background-attachment: fixed;
    opacity: var(--parallaxOpacity);
    display: flex;
    justify-content: center;
    align-items: center;
  }



  .parallax__image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .parallax__content {
    position: relative;
    z-index: 1;
  }
  @media screen and (min-width: 636px) {
    .parallax__container {
    height: var(--parallaxHeight);
  }
  .parallax__image {
    height:  calc(var(--parallaxHeight));
  }
  }

  </style>


  <script   define:vars={{parallaxEffect}}>

    function parallaxImage(){
      window.addEventListener('scroll', function () {
      const parallax = document.querySelector('.parallax__image');
      const scrolled = window.scrollY;
      if (parallax)
      parallax.style.transform = `translateY(calc(-50% + ${scrolled * parallaxEffect}px))`; // Adjust speed
    });

    }

    // Run once at start
    parallaxImage()
    // Run on view transitions
    document.addEventListener("astro:after-swap", parallaxImage);

  </script>