---
import { Image } from 'astro:assets';
const { image, parallaxEffect } = Astro.props;
---


<div class="parallax__container">
    <div class="parallax__image">
      <Image src={image} alt="Logo image." width="1000" height="899" />
    </div>
    <div class="parallax__content">
      <slot />
    </div>
  </div>



  <style>

    /* In your global CSS file or component style block */
  .parallax__container {
    background-color: white;
    height: 45vw; /* Adjust as needed */
    width: 100%;
    margin: auto;
    overflow: hidden;
    position: relative;
    z-index: 0;
  }

  .parallax__image {
    position: absolute;
    top: -150px;
    left: 0;
    width: 100%;
    height:  45vw; /* Larger than container for the effect */
    transform: translateZ(0); /* Avoid paint issues on some browsers */
    will-change: transform;
    background-attachment: fixed;
    opacity: 0.5;
  }



  .parallax__image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .parallax__content {
    position: relative;
    z-index: 1;
  }
  @media screen and (min-width: 636px) {
    .parallax__container {
    height: 10vw; /* Adjust as needed */
  }
  .parallax__image {
    height:  20vw; /* Larger than container for the effect */
  }
  }

  </style>


  <script   define:vars={{parallaxEffect}}>

    function parallaxImage(){
      window.addEventListener('scroll', function () {
      const parallax = document.querySelector('.parallax__image');
      const scrolled = window.scrollY;
      if (parallax)
      parallax.style.transform = `translateY(${scrolled * parallaxEffect}px)`; // Adjust speed
    });

    }

    // Run once at start
    parallaxImage()
    // Run on view transitions
    document.addEventListener("astro:after-swap", parallaxImage);

  </script>