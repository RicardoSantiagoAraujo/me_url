---
const gitHubReadMe = Astro.props.gitHubReadMe;
---
<pre>
<code class="readme--container">
</code>
</pre>

<script type="module" define:vars={{gitHubReadMe}}>
  import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js';

  function readMe(){
    // "https://raw.githubusercontent.com/your-username/your-project-name/branch-name/file-name.md";
    const endpoint = `https://raw.githubusercontent.com/${gitHubReadMe.username}/${gitHubReadMe.repoName}/${gitHubReadMe.branch}/${gitHubReadMe.filename}`;

    fetch(endpoint)
      .then(response => {
        if (!response.ok) {
          // throw new Error('Network response was not ok');
          return `<div class="readme-error" style='color:darkred; font-weight:bold; text-align:center'>ERROR 404: README not found.</div>`;
        }
        return response.text();
      })
      .then(markdown => {
        var readmeContainer = document.querySelector(".readme--container");
        if (readmeContainer){
          readmeContainer.innerHTML = marked.parse(markdown);
        }

      })
      .then(() => {
          const errorEl = document.querySelector('.readme--container .readme-error');
          if (errorEl){
            errorEl.parentElement.parentElement.parentElement.parentElement.style.background = 'rgba(255, 0, 0, 0.1)';
            console.error('README not found at the specified location.');
          }
        })
        .catch(error => {
          console.error('There was a problem with the fetch operation for the README file:', error);
        });
  }

  readMe()
  document.addEventListener("astro:after-swap", (event) => {
    readMe();  // Call your function
  });


</script>

<style>
  .readme--container {
    position: relative;
    width: 100%;
    display: block;
    text-wrap: auto;
    p {
      position: relative;
      width:100%
    }

    pre{
      padding: 3px;
      background-color: rgba(0, 0, 0, 0.667);
      color: white;
    }
  }

</style>