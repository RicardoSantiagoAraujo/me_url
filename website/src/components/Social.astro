---
const { platform, icon, faIcon, address, height } = Astro.props;
import { Image } from 'astro:assets';
---
<a class="social" href={`https://www.${address}`}>
  {icon !== null ? <Image class="social-icon" src={icon}  alt={`icon for ${platform}`}/> : null}
  {faIcon !== null ? <span class={`social-faicon fa ${faIcon}`}></span> : null}
  <span class="social-text">{platform}</span>
</a>

<style  lang="scss" define:vars={{ height }}>
    @use 'sass:color';
    @use '../styles/variables/colors' as c;
    a.social {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 0.5rem;
      min-width: 125px;
      border-radius: 10px;
      color: rgb(0, 0, 0);
      background-color: color.scale(c.$color-white, $alpha: -60%);
      &:hover {
        background-color: color.scale(c.$color-white, $alpha: -30%);
      transition: 0.2s ease-in-out;

      }
      &:active {
        background-color: color.scale(c.$color-white, $alpha: -0%);
        transition: 0.05s ease-in-out;
      }
      text-decoration: none;
      .social-icon {
        height:  calc(var(--height) * 0.8);
        width: auto;
      }
      .social-faicon {
        display: none;
      }
      .social-text {
        display: none;
      }
    }

    @media screen and (min-width: 636px) {
      a.social {
      min-width: 150px;
      padding: 0.5rem 1rem;
      .social-icon {
        height: var(--height);
        width: auto;
      }
      }

  }

</style>