---
import '@/styles/variables/_colors.scss';
import { Icon } from 'astro-icon/components'
import { generalParameters } from '@/data/base/_general';
import { getLangFromUrl } from "@/i18n/utils";
const lang : string = getLangFromUrl(Astro.url);

const { tag_id, collectionName, showTooltip=true } = Astro.props;

const color="white";
const colorHover="red";
const colorActive="blue";



const tag = generalParameters.tags[tag_id]
---

<div class="tech__container">
    <a href={`/${lang}/tags/${collectionName}/${tag_id}`}
    data-tooltip={showTooltip ? tag.description ? tag.description : null: null}>
        {tag.name}
    </a>
</div>


<style define:vars={{ color, colorHover, colorActive}}>
</style>


<script>
</script>