---
import { getCollection } from "astro:content";
import { getLangFromUrl } from "../../../i18n/utils";
import type { arrayOutputType } from "astro:schema";
const componentMap = {
  projects:   import('../projects/ProjectCard.astro') ,
  experience:    import('../experience/ExperienceCard.astro'),
  education:    import('../education/EducationCard.astro'),
} as const;
const targetCollectionName = Astro.props.collectionName as keyof typeof componentMap;
const ListItem = (await componentMap[targetCollectionName]).default;

const collectionName = Astro.props.collectionName as keyof typeof import('../../../content.config.ts').collections;
const lang = getLangFromUrl(Astro.url);

var { items } = Astro.props;
// If no items are passed, fetch the whole collection by default
if (!items) {
  items = await getCollection(collectionName);
}
---
  <ul class="collection-card-list">
    {
      items
      .filter((item: any)=> item.data.include !== false) // filter out excluded items
      .map((item: any) => {
        const itemLang = item.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        const data = {
            ...item.data,
            url: "/" + item.id.replace("/", `/${collectionName}/`) // fix the URL to match the expected format
        };
        // const itemLang = item.id.split('/')[0];
        return <ListItem data={data} />
      })
    }
  </ul>