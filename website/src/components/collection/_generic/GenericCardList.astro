---
import { getCollection } from "astro:content";
import { getLangFromUrl } from "../../../i18n/utils";
const dynamicListItem = `../${Astro.props.collectionName}/${Astro.props.listItemComponent}.astro`;
const ListItem = (await import(/* @vite-ignore */ dynamicListItem)).default;


const collectionName = Astro.props.collectionName as keyof typeof import('../../../content.config.ts').collections;
const lang = getLangFromUrl(Astro.url);
const allItems = await getCollection(collectionName);
---
  <ul class="collection-card-list">
    {
      allItems
      .filter((item)=> item.data.include !== false) // filter out excluded items
      .map((item) => {
        const itemLang = item.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        const data = {
            ...item.data,
            url: "/" + item.id.replace("/", `/${collectionName}/`) // fix the URL to match the expected format
        };
        // const itemLang = item.id.split('/')[0];
        return <ListItem data={data} />
      })
    }
  </ul>