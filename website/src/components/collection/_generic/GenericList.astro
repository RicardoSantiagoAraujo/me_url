--- 
import { generateItemRoutes } from "../../../scripts/dynamicRoutes";
import { getLangFromUrl } from "../../../i18n/utils";
const componentMap = {
  blog:    import('../blog/BlogPostLink.astro'),
  collectionTemplate:    import('../collectionTemplate/CollectionTemplateLink.astro'),
} as const;
const targetCollectionName = Astro.props.collectionName as keyof typeof componentMap;
const ListItem = (await componentMap[targetCollectionName]).default;

const collectionName = Astro.props.collectionName as keyof typeof import('../../../content.config.ts').collections;
const lang = getLangFromUrl(Astro.url);
const allItems = await generateItemRoutes(collectionName);

---
  <ul class="collection-list">
    {
      allItems
      // .filter((item)=> item.props.data.include !== false) // filter out excluded items
      .sort((a, b) => {
        return a.props.id.localeCompare(b.props.id, undefined, { numeric: true }); // order items: localeCompare works for any string and sorts based on Unicode order.
      })
      .map((item) => {
        const itemLang = item.props.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        const data = {
            ...item.props.data,
            url: "/" + item.props.id.replace("/", `/${collectionName}/`) // fix the URL to match the expected format
        };
        // const itemLang = item.id.split('/')[0];
        return <ListItem   data={data} />
      })
    }
  </ul>