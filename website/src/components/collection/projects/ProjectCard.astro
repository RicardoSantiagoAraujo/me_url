---
const {data} = Astro.props

---

<li class="collection-item"><a href={data.url}>
    <div>
        {data.title}{data.subtitle}
    </div>
    <div>
        {data.description}
        <img src={data.images[0].url} alt={data.images[0].alt}  width="300px">
    </div>
    <div>
        {data.tags}
    </div>
</a></li>