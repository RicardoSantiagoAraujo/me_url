---
import { generateCollectionItemRoutes } from "@/scripts/dynamicRoutes";
import { getLangFromUrl } from "@/i18n/utils";

import { collections } from "@/content.config.ts";
const targetCollectionName = Astro.props.collectionName as keyof typeof collections;
const itemListComponent = Astro.props.itemListComponent;
const componentImport =  import(`../${targetCollectionName}/${itemListComponent}.astro`);
const ListItem = (await componentImport).default;

const lang = getLangFromUrl(Astro.url);
const allItems = await generateCollectionItemRoutes(targetCollectionName);

---
  <ul class="collection-list">
    {
      allItems
      // .filter((item)=> item.props.data.include !== false) // filter out excluded items
      .sort((a, b) => {
        return a.props.id.localeCompare(b.props.id, undefined, { numeric: true }); // order items: localeCompare works for any string and sorts based on Unicode order.
      })
      .map((item) => {
        const itemLang = item.props.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        const data = {
            ...item.props.data,
            url: "/" + item.props.id.replace("/", `/${targetCollectionName}/`) // fix the URL to match the expected format
        };
        // const itemLang = item.id.split('/')[0];
        return <ListItem   data={data} />
      })
    }
  </ul>