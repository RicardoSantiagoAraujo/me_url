---
const {data} = Astro.props;
import "./../../../styles/collections/projects/_cards.scss";
import { getLangFromUrl } from "@/i18n/utils";
import TechstackIcon from "@/components/TechstackIcon.astro";
import IconLink from "@/components/IconLink.astro";
import Image from "astro/components/Image.astro";
import Figure from "@/components/figure/Figure.astro";
import {getImageFromZArray} from '@/scripts/utils';

const lang : string = getLangFromUrl(Astro.url);

const cardImg   = getImageFromZArray("idMainImg", data);
const bgImg = getImageFromZArray("idBgImg", data);
const bgImg_alt = bgImg?.alt ? bgImg?.alt : bgImg?.title;

---
    <li class="collection-item">
        <div  class="collection-item__header">
            <a href={data.url}>
                <span class="collection-item__header__title">{data.title}</span>
                {data.subtitle &&  <span class="collection-item__header__subtitle">: {data.subtitle}</span>}
            </a>
            <div class="collection-item__header__link-group">
                 <a href={data.url} class="collection-item__header__link" data-tooltip=`Go to project details`><i class="fa-solid fa-book-open"></i></a>
                <IconLink link={data.repository} faIcon="fa-brands fa-github" tooltip=`Go to repository at ${data.repository}`/>
                <IconLink link={data.documentation} faIcon="fa-solid fa-question" tooltip=`Go to documentation at ${data.documentation}`/>
                <IconLink link={data.externalLink} faIcon="fas fa-external-link" tooltip=`Go to demo at ${data.externalLink}`/>
            </div>
        </div>
        <div class="collection-item__body">
            <div class="collection-item__body__left">
                <div class="collection-item__body__description">{data.descriptionShort}</div>
                <div class="tags-container">
                    <span>Tags:</span>
                    <ul class="tag-list">
                        {data.tags.map((item: any) =>  item.include && <li class="tag-list__item"><a href={`/${lang}/tags/projects/${item.name}`}>{item.name}</a></li>)}
                    </ul>
                </div>
            </div>
                {cardImg &&<div class="collection-item__body__right">
                    <div class="collection-item__body__image-container">
                        <Figure figureData={cardImg} showCaption={false} allowZoom={true}/>
                    </div>
                </div>}
                {bgImg && <div class="collection-item__body__bg-image-container">
                     <Image  src={bgImg.url} alt={bgImg_alt} style={bgImg.styleAsBg} inferSize={true} class="collection-item__body__bg-image"/>
                </div>}
        </div>
        <div class="collection-item__footer">
            <ul class="techstack-list">{data.techstack.map((item: any) => {return item.include && <li class="tag-list__item"> <TechstackIcon tech_id={item.id}></TechstackIcon> </li>} )}</ul>
            <ul class="field-list">{data.fields.map((item: any) => {return item.include && <li class="tag-list__item"><a>{item.name}</a></li>} )}</ul>
        </div>

    </li>