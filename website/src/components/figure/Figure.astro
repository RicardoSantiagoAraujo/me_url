---
import { Image } from 'astro:assets';
import FigureCaption from './FigureCaption.astro';
import '@/styles/components/figure/_main.scss';

const { figureData, showCaption = true, allowZoom = true } = Astro.props;
const contentType: "img" | "vid" = Astro.props.contentType || "img";

// Dynamically import images
const images = import.meta.glob<{ default: ImageMetadata }>(`/src/assets/**/*.{jpeg,jpg,png,gif,svg}`);

// Fallbacks for caption and alt
const fig_caption = figureData.caption || figureData.title;
const fig_alt = figureData.alt || fig_caption;
const extra_info = `${figureData.title} : ${fig_caption}`;
---

<figure class={`fig ${allowZoom && 'allowZoom'} ${!showCaption && 'no_caption'}`}             data-title={figureData.title} data-caption={fig_caption} data-extra={extra_info}>
    <!-- IMAGE -->
    {contentType === "img" ? (
        <Image
            class="fig__img"
            src={images[figureData.url] ? images[figureData.url]() : figureData.url}
            alt={fig_alt}
            inferSize={true}
            style={figureData.style}
        />
    ) : null }

    <!-- VIDEO -->
    {contentType === "vid" ? (
        <iframe
            class="fig__vid"
            src={figureData.url}
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
        ></iframe>
    ) : null }

    <!-- CAPTION -->
    {showCaption && <FigureCaption captionData={figureData} extraInfo={extra_info} />}
</figure>
