---
import { Image } from 'astro:assets';
import FigureCaption from './FigureCaption.astro';
import '@/styles/components/figure/_main.scss';
const { figureData, showCaption = true, allowZoom = true } = Astro.props;
const contentType: "img" | "vid" = Astro.props.contentType || "img";
const images = import.meta.glob<{ default: ImageMetadata }>(`/src/assets/**/*.{jpeg,jpg,png,gif,svg}`);
const fig_caption = figureData.caption ? figureData.caption : figureData.title;
const fig_alt = figureData.alt ? figureData.alt : fig_caption;
---


<figure class=`fig ${allowZoom && 'allowZoom'} ${!showCaption && 'no_caption'}`>
    <!-- IMAGE -->
    {contentType === "img" ?
        <Image  class=`fig__img` src={images[figureData.url] ? images[figureData.url]() : figureData.url} alt={`${fig_alt}`} inferSize={true}  data-title=`${figureData.title}` data-caption=`${fig_caption}`/>
    : null }
    <!-- VIDEO -->
    {contentType === "vid" ? 
    <iframe class=`fig__vid` src={figureData.url}  title="YouTube video player"  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> 
     : null
    } 
    <!-- CAPTION -->
    <FigureCaption captionData={figureData} />
</figure>
