---
import '../../styles/components/figure/_main.scss';
---

<!-- to view images in fullscreen mode -->
<div class="fullpage__bg"></div>
<div class="fullpage">
    <div class="fullpage_extras">
        <div id="fullpage__caption">Caption container</div>
        <div class="fullpage__btns">
            <button id="fullpage__btn__prev">
                <img src="/src/icons/ui/arrow.svg" alt="arrow previous image">
            </button>
            <button id="fullpage__btn__next">
                <img src="/src/icons/ui/arrow.svg" alt="arrow previous image">
            </button>
        </div>
        <button id="fullpage__btn__exit">
            <img src="/src/icons/ui/cross.svg" alt="close fullscreen image" />
        </button>
        <div id="fullpage__info_container">
            <button id="fullpage__btn__info"> More </button>
            <div id="fullpage_extra_information"></div>
        </div>
    </div>
</div>
