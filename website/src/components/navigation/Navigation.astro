---
import Logo from "./../Logo.astro"
import NavigationItem from "./NavigationItem.astro";
import NavigationGroup from "./NavigationGroup.astro";
import { collectionsMetadata } from "@/content.config";

---
<div class="nav-links">
    <!-- <Logo /> -->
    <NavigationItem dir={"."} target="about"/>
    {Object.entries(collectionsMetadata).map(([key, val])=>
                         <NavigationItem  dir={"."}  target={key}/>)}
    <NavigationGroup groupName={`more`} dir={"."} targets={['tags']} />
    <!-- <NavigationGroup groupName={`example-dropdownGroup`} dir={"dropdownGroup"} targets={['example-dropdownItem','example-dropdownItem']} /> -->
</div>