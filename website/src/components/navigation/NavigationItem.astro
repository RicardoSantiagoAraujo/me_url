---
import Logo from "./../Logo.astro"
import { getLangFromUrl, useTranslations , useTranslatedPath} from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const {target, dir } = Astro.props as { target: 'home' | 'about' | 'styles'; dir: string  }; // keep up to date with the available targets - does not actually need to be be up to date

const { pathname } = Astro.url;
const isCurrentSection = pathname == translatePath(`/${dir}/${target}/`);
console.log(isCurrentSection)

---

<a class={`link nav_element ${isCurrentSection ? "nav_element--active" : ""}`} href={translatePath(`/${dir}/${target}/`)}>{t(`nav.${target}`)}
</a>
