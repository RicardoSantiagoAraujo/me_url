---
const { data } = Astro.props;
import { formatDate, formatDateBalloon } from "@/scripts/utils";
import { getImageFromZArray } from "@/scripts/utils";
import Figure from "../figure/Figure.astro";
const cardImg   = getImageFromZArray("idMainImg", data);

---

<li class="balloon">
    <div class="balloon-content">
        <div class="balloon-inner">
        <div class="balloon-main">
            <div class="balloon-collection-name">{data.collectionName}</div>
            <time class="balloon-date" datetime={data.dateStart}>{formatDateBalloon(data.dateStart)} - {formatDateBalloon(data.dateEnd)}</time>
            <div class="balloon-title"><a href={`${data.url}`} >{data.title}</a></div>
        </div>
        <div class="balloon-extra">
            <div class="balloon-description">{data.descriptionShort}</div>
            <div class="balloon-location">{data.location}</div>
        </div>
        </div>
   </div>
   <div class="balloon--outside">
        <div class="balloon-date--outside">{formatDate(data.dateStart)}</div>
        {cardImg &&<div class="balloon-img--outside">
                    <Figure figureData={cardImg} showCaption={false} allowZoom={false}/>
        </div>}
   </div>
</li>