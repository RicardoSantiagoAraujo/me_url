---
import BaseLayout from './../BaseLayout.astro';
import { getLangFromUrl } from './../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
import TechstackIcon from '../../components/TechstackIcon.astro';
import Image from "astro/components/Image.astro";
import {getImageFromZArray} from './../../scripts/utils';
import './../../styles/collections/_genericLayout.scss';
import Figure from '../../components/figure/Figure.astro';


const { frontmatter, collection } = Astro.props;

// const cardImg = getImageFromZArray("idMainImg", frontmatter);
const bgImg = getImageFromZArray("idBgImg", frontmatter);
const images = import.meta.glob<{ default: ImageMetadata }>(`/src/assets/**/*.{jpeg,jpg,png,gif,svg}`);
frontmatter.lang = currentLang;
---
<BaseLayout>
  <div class="genericLayout-page__header">
    <div class="genericLayout-page__header__bg-container">
      {bgImg.meta &&
      <Image  src={bgImg.img} alt={bgImg.meta.alt} inferSize={true} class="genericLayout-page__header__bg-img"/>
      }
    </div>
    <div class="genericLayout-page__header__titles">
      <h1>{frontmatter.title}</h1>
      {frontmatter.subtitle && <h2>{frontmatter.subtitle}</h2>}
    </div>
    {frontmatter.authors &&
    <div class="genericLayout-page__header__authors">
        <span class="authors_prefix">Authors:</span>
          {frontmatter.authors.map((item: any, index: number,array: any[]) => item.include &&
          <span class="author-list__item">
            {item.name} {item.surname}
            {index < array.length - 1 ? ', ' : ''}
          </span> )}
    </div>
    }
  </div>

  <div class="genericLayout-page__links">
    {frontmatter.repository && <a data-tooltip={`Go to repository at www.${frontmatter.repository}`} data-tippy-placement="left" href={"https://"+frontmatter.repository} class="page__links__repository"><i class="fa-brands fa-github"></i></a>}
    {frontmatter.externalLink && <a data-tooltip={`Go to demo at www.${frontmatter.repository}`} data-tippy-placement="left" href={"https://"+frontmatter.externalLink} class="page__links__external-link"><i class="fas fa-external-link"></i></a>}
  </div>

  <div class="genericLayout-page__tags">
    <span class="tags_prefix">Tags:</span>
    <div class="tags">
      {frontmatter.tags.map((item: any) => (
        <p class="tag"><a href={`/${currentLang}/tags/${collection}/${item.name}`}>{item.name}</a></p>
      ))}
    </div>
  </div>


  <div class="genericLayout-page__lists">
    <div class="genericLayout-page__list genericLayout-page__techstack">
        <ul>
          {frontmatter.techstack.map((item: any) => item.include && <li class="author-list__item">
            {<TechstackIcon tech_id={item.id}></TechstackIcon>}
            </li> )}
        </ul>
    </div>
    <div class="genericLayout-page__list genericLayout-page__fields">
        <ul>
          {frontmatter.fields.map((item: any, index: number,array: any[]) => item.include && <li class="author-list__item">
            {item.name}
            {index < array.length - 1 ? ', ' : ''}
            </li> )}
        </ul>
    </div>
  </div>
  <!-- <p>{f rontmatter.datePublication.toLocaleDateString()}</p> -->

  <p><em>{frontmatter.description}</em></p>

  {frontmatter.descriptionList &&  frontmatter.descriptionList.length > 0 ?
  <ul class="descriptionList">
  {frontmatter.descriptionList?.map((item: any) =>
  <li >
  {item.item}
  </li>
  )}
  </ul> : ""}


  <div class="genericLayout-page__images">
    {frontmatter.images?.map((item: any) => item.include && <div class="genericLayout-page__images__image-container">
    <Figure imageData={item} />
    </div> )}
  </div>


  <slot /> <!-- slot injects contents of .md file  -->
</BaseLayout>

<script>
//////////////////////////////////////////////////////////////////////////////
/** make text appear in the innerHTML of the element, one character at a time per timeBetween */
function appearChars(str: string, elem: HTMLElement, timeBetween: number) {
  var index = -1;
  (function go() {
    if (++index < str.length) {
      elem.innerHTML = elem.innerHTML + str.charAt(index);
      setTimeout(go, timeBetween);
    }
  })();
}

var elem = document.querySelector<HTMLElement>('.genericLayout-page__header__titles h1')!;
var inner_text = elem.innerHTML; // store content
elem.innerHTML = ""; // empty element
var timeBetween = 50;
setTimeout(() => {
  appearChars(inner_text, elem, timeBetween);
}, 500) // wait a little bit before starting


</script>