---
import BaseLayout from './../BaseLayout.astro';
import { getLangFromUrl } from './../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
import TechstackIcon from '@/components/TechstackIcon.astro';
import TagComponent from '@/components/TagComponent.astro';
import IconLink from '@/components/IconLink.astro';
import Image from "astro/components/Image.astro";
import {getImageFromZArray} from './../../scripts/utils';
import './../../styles/collections/_genericLayout.scss';
import Figure from '@/components/figure/Figure.astro';
import Accordion from '@/components/Accordion.astro';


const { frontmatter, collection } = Astro.props;

// const cardImg = getImageFromZArray("idMainImg", frontmatter);
const bgImg = getImageFromZArray("idBgImg", frontmatter);
const bgImg_alt = bgImg?.alt ? bgImg?.alt : bgImg?.title;
// const images = import.meta.glob<{ default: ImageMetadata }>(`/src/assets/**/*.{jpeg,jpg,png,gif,svg}`);
frontmatter.lang = currentLang;
---
<BaseLayout>
  <div class=`genericLayout-page__header ${bgImg ? 'with-bg' : ''}`>
    <div class="genericLayout-page__header__bg-container">
      {bgImg &&
      <Image  src={bgImg.url} alt={bgImg_alt} style={bgImg.styleAsBg} inferSize={true} class="genericLayout-page__header__bg-img"/>
      }
    </div>
    <div class=`genericLayout-page__header__titles ${frontmatter.subtitle && 'with-subtitle'}`>
      <h1>{frontmatter.title}</h1>
      {frontmatter.subtitle && <h2>{frontmatter.subtitle}</h2>}
    </div>
    {frontmatter.authors &&
    <div class="genericLayout-page__header__authors">
        <span class="authors_prefix">Authors:</span>
          {frontmatter.authors.map((item: any, index: number,array: any[]) => item.include &&
          <span class="author-list__item">
            {item.name} {item.surname}
            {index < array.length - 1 ? ', ' : ''}
          </span> )}
    </div>
    }
  </div>

  <div class="genericLayout-page__links">
    <IconLink link={frontmatter.repository} faIcon="fa-brands fa-github" tooltip=`Go to repository at ${frontmatter.repository}` tooltipPlacement="left"/>
    <IconLink link={frontmatter.documentation} faIcon="fa-solid fa-question" tooltip=`Go to documentation at ${frontmatter.documentation}` tooltipPlacement="left"/>
    <IconLink link={frontmatter.externalLink} faIcon="fas fa-external-link" tooltip=`Go to demo at ${frontmatter.externalLink}` tooltipPlacement="left"/>
  </div>

  <div class="genericLayout-page__tags">
    <span class="tags_prefix">Tags:</span>
    <div class="tags">
      {frontmatter.tags.map((item: any) => (
        <div class="tag"><TagComponent collectionName={collection} tag_id={item.id}/></div>
      ))}
    </div>
  </div>


  <div class="genericLayout-page__lists">
    <div class="genericLayout-page__list genericLayout-page__techstack">
        <ul>
          {frontmatter.techstack.map((item: any) => item.include && <li class="author-list__item">
            {<TechstackIcon tech_id={item.id}></TechstackIcon>}
            </li> )}
        </ul>
    </div>
    <div class="genericLayout-page__list genericLayout-page__fields">
        <ul>
          {frontmatter.fields.map((item: any, index: number,array: any[]) => item.include && <li class="author-list__item">
            {item.name}
            {index < array.length - 1 ? ', ' : ''}
            </li> )}
        </ul>
    </div>
  </div>
  <!-- <p>{f rontmatter.datePublication.toLocaleDateString()}</p> -->

  <p><em>{frontmatter.description}</em></p>

  {frontmatter.descriptionList &&  frontmatter.descriptionList.length > 0 ?
  <ul class="descriptionList">
  {frontmatter.descriptionList?.map((item: any) =>
  <li >
  {item.item}
  </li>
  )}
  </ul> : ""}


<!-- IMAGES -->
{frontmatter.images && frontmatter.images.filter((img:any)=>img.include===true).length > 0 &&
  <Accordion title="Figures" startCollapsed={false}>
    <div class="genericLayout-page__images">
      {frontmatter.images?.map((item: any) => item.include && <div class="genericLayout-page__images__image-container">
      <Figure figureData={item} contentType="img" />
      </div> )}
    </div>
  </Accordion>
}


<!-- VIDEOS -->
{frontmatter.videos && frontmatter.videos.length > 0 &&
  <Accordion title="Videos" startCollapsed={false}>
    <div class="genericLayout-page__videos">
      {frontmatter.videos?.map((item: any) => item.include && <div class="genericLayout-page__videos__video-container">
      <Figure figureData={item} contentType="vid" />
      </div> )}
    </div>
  </Accordion>
}

<!-- SLOT CONTENTS -->
{Astro.slots.default  && (await Astro.slots.render('default')).replace(/\s/g, "").length > 0  &&
    <Accordion title="Contents" startCollapsed={true}>
    <slot /> <!-- slot injects contents of .md file  -->
  </Accordion>
}


</BaseLayout>

<script>
/**
 * Handles the appearance of characters in the specified element.
 * @param str - The string to display.
 * @param elem - The element to update.
 * @param timeBetween - The time interval between each character.
 */
function appearChars(str: string, elem: HTMLElement, timeBetween: number) {
  var index = -1;
  (function go() {
    if (++index < str.length) {
      elem.innerHTML = elem.innerHTML + str.charAt(index);
      setTimeout(go, timeBetween);
    }
  })();
}

var elem = document.querySelector<HTMLElement>('.genericLayout-page__header__titles h2')!;
if (elem != null){
  var inner_text = elem.innerHTML; // store content
  elem.innerHTML = ""; // empty element
  elem.style.opacity = "1"; // make element visible (was hidden with opacity:0 in CSS)
  var timeBetween = 50;
  setTimeout(() => {
    appearChars(inner_text, elem, timeBetween);
  }, 500) // wait a little bit before starting
}



</script>