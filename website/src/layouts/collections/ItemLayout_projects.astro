---
import BaseLayout from './../BaseLayout.astro';
import { getLangFromUrl } from './../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);

const { frontmatter } = Astro.props;
console.log(frontmatter)
frontmatter.lang = currentLang;
---
<BaseLayout pageTitle={frontmatter.title}>
  <p><em>{frontmatter.description}</em></p>
  <p>{frontmatter.datePublication.toLocaleDateString()}</p>

  <p>Written by: {frontmatter.authors}</p>

  <!-- <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} /> -->

  <div class="tags">
    {frontmatter.tags.map((tag: string) => (
      <p class="tag"><a href={`/${currentLang}/tags/projects/${tag}`}>{tag}</a></p>
    ))}
  </div>


  <slot /> <!-- slot injects contents of .md file  -->
</BaseLayout>


<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>