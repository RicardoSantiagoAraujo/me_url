---
import BaseLayout from './../BaseLayout.astro';
import { getLangFromUrl } from './../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);

const { frontmatter } = Astro.props;
// console.log(frontmatter)
frontmatter.lang = currentLang;
---
<BaseLayout pageTitle={frontmatter.title}>
  <h2>{frontmatter.subtitle}</h2>
  <h3>{frontmatter.repository}</h3>
  <h3>{frontmatter.externalLink}</h3>

  Authors:
  <ul>
    {frontmatter.authors.map((item: any) => item.include && <li class="author-list__item">{item.name} {item.surname} </li> )}
  </ul>
    Fields:
  <ul>
    {frontmatter.fields.map((item: any) => item.include && <li class="author-list__item">{item.name}  </li> )}
  </ul>
    Techstack:
  <ul>
    {frontmatter.techstack.map((item: any) => item.include && <li class="author-list__item">{item.id} </li> )}
  </ul>
  <!-- <p>{f rontmatter.datePublication.toLocaleDateString()}</p> -->

  <p><em>{frontmatter.description}</em></p>

  <div> Images:
    {frontmatter.images.map((item: any) => item.include && <div class="tag-list__item"> <img width="300px" alt={item.caption} src={item.url}/> </div> )}
  </div>

  Tags:
  <div class="tags">
    {frontmatter.tags.map((item: string) => (
      <p class="tag"><a href={`/${currentLang}/tags/projects/${item.name}`}>{item.name}</a></p>
    ))}
  </div>




  <slot /> <!-- slot injects contents of .md file  -->
</BaseLayout>


<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>