---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GenericCardList from '@/components/collections/_generic/GenericCardList.astro';
import { collectionsMetadata } from "@/content.config";

// Destructure `tag`, `items`, and `collection` from Astro.params and Astro.props
const { tag } = Astro.params;
const { items, collectionName } = Astro.props;

const collectionMetadata = collectionsMetadata[collectionName as keyof typeof collectionsMetadata];


---
<BaseLayout pageTitle={tag}>
  <p> <span style="text-transform: capitalize">{String(collectionName)}</span> entries tagged with {tag}</p>
  <GenericCardList collectionName={collectionName} items={items} listItemComponent={collectionMetadata.itemListComponent}  orderBy={collectionMetadata.orderBy} sortOrder = {collectionMetadata.sortOrder} />
</BaseLayout>