---
import { getCollection } from "astro:content";
import type { DataEntryMap } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
const { collectionNames } = Astro.props;
import { getLangFromUrl} from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
import TagComponent from "@/components/TagComponent.astro";

var tagsPerCollection  = {} as {[key: string]: any[]};
for (let collectionName of collectionNames){
  const allCollectionItems = await getCollection(collectionName as keyof DataEntryMap);
  //filter out excluded CollectionItems
  const includedCollectionItems = allCollectionItems
  .filter((item: any)=>item.data.include==true)
  .filter((item:any)=>(item.id as string).startsWith(lang));
  console.log(includedCollectionItems)
  // Get tags from all CollectionItems
  const tags = [...new Set(includedCollectionItems.map((item : any) => item.data.tags).flat())]
  // Filter out excluded tags
  .filter((tag)=>tag.include==true)
  // Remove duplicates
  const uniqueTags = [...new Map(tags.map(tag => [tag.id, tag])).values()];
  if (uniqueTags.length > 0){
    tagsPerCollection[collectionName] = uniqueTags;
  }
} 


const pageTitle = "Tag Index";
---

<BaseLayout pageTitle={pageTitle}> 
  {
    Object.entries(tagsPerCollection).map(([collectionName, cleanedTags]) => (
      <div class={collectionName}>
        <h3 style="text-transform: capitalize;"><a href="" style="text-decoration: none; color: black">{collectionName}</a></h3>
        <div class="tags">
        {// TAG LIST
        cleanedTags.length == 0 ?
        <p>No tags available.</p>  
        :  cleanedTags
          .sort((a, b) => a.id.localeCompare(b.id)) // Sort by tag id
          .map((tag) => (
            <div class="tag">
              <TagComponent collectionName={collectionName} tag_id={tag.id}/>
            </div>
          ))}
          </div>
      </div>
    ))
  }

</BaseLayout>
<style>
  a {
    color: #00539f;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #d3d5d6;
    a{
      color: black;
      text-decoration: none;
    }
  }
</style>