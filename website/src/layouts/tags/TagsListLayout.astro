---
import { getCollection } from "astro:content";
import type { DataEntryMap } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
const { collectionNames } = Astro.props;
import { getLangFromUrl} from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);

var tagsPerCollection  = {} as {[key: string]: any[]};
for (let collectionName of collectionNames){
  const allItems = await getCollection(collectionName as keyof DataEntryMap);
  const tags = [...new Set(allItems.map((item : any) => item.data.tags).flat())];
  const uniqueTags = [...new Map(tags.map(tag => [tag.name, tag])).values()];
  tagsPerCollection[collectionName] = uniqueTags;
}


const pageTitle = "Tag Index";
---

<BaseLayout pageTitle={pageTitle}>

  {
    Object.entries(tagsPerCollection).map(([collectionName, cleanedTags]) => (
      <div class={collectionName}>
        <h3 style="text-transform: capitalize;">{collectionName}</h3>
        <div class="tags">
        {cleanedTags
          .sort((a, b) => a.name.localeCompare(b.name)) // Sort by collection ID
          .map((tag) => (
            <p class="tag">
              <a href={`/${lang}/tags/${collectionName}/${tag.name}`}>{tag.name}</a>
            </p>
          ))}
          </div>
      </div>
    ))
  }

</BaseLayout>
<style>
  a {
    color: #00539f;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: #d3d5d6;
    a{
      color: black;
      text-decoration: none;
    }
  }
</style>