---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLangFromUrl, translateRoute } from "@/i18n/utils";
import { defaultLang } from "@/i18n/ui";

const pageTitle = "MISSING PAGE";
const lang = getLangFromUrl(Astro.url);
const path = Astro.url.pathname.replace(`/${lang}`, "").replaceAll("/", "");
const routeInDefaultLang = translateRoute(path, lang, defaultLang);
const redirectPath = `/${defaultLang}/${routeInDefaultLang}`;
var redirect = false;
if (routeInDefaultLang && routeInDefaultLang !== path){ // A translation exists
  console.log(`REDIRECTING TO: ${redirectPath}`);
  redirect = true;
}

---
<BaseLayout pageTitle={pageTitle}>

  <!-- Element to hold data attributes for client side script -->
  <div id="data" data-redirectpath={redirectPath} data-redirect={redirect}></div>

  {redirect ? (
    <p style="color: red; text-align: center; font-size: 30px">
      This page has yet to be translated for the chosen language ({lang}). You will be redirected to the default language ({defaultLang})...
    </p>
    <p style="color: blue; text-align: center; font-size: 30px">Timer: <span id="timer"></span></p>
  ) :
  <p style="color: red; text-align: center; font-size: 50px">This page does not exist.</p>
    </p>
  }
</BaseLayout>

<script is:inline>
    data = document.getElementById('data').dataset;
    const redirectpath = data.redirectpath;
    const redirect = data.redirect;

    // Set the starting time in seconds (for example, 10 seconds)
    let timeRemaining = 1000;
    const freq = 100;
    // Select the element where the countdown will be displayed
    const timerElement = document.getElementById('timer');
    if (timerElement){
      timerElement.textContent = timeRemaining/1000;
    }
    // Function to update the countdown
    function updateCountdown() {
      // Update the text content to show the remaining time
      timerElement.textContent = timeRemaining/1000;
      // Decrease the time by 1 second
      timeRemaining-= freq;
      // If the time reaches 0, stop the countdown
      if (timeRemaining < 0) {
        clearInterval(countdownInterval);
        timerElement.textContent = 'Redirecting!';
        window.location.href = redirectpath;
      }
    }

  var countdownInterval;

  if (redirect == "true"){ // A translation exists
    console.log(`REDIRECTING TO: ${redirectpath} in ${timeRemaining} seconds...`);
    // Set an interval to update the countdown every 1000ms (1 second)
    countdownInterval = setInterval(updateCountdown,  freq);
  } else {
    console.log("NO TRANSLATION FOUND FOR THIS ROUTE IN DEFAULT LANG");
  }

</script>