---

import {render } from 'astro:content';
import ItemLayout_blog from '@/layouts/collections/ItemLayout_blog.astro';
import {generateItemRoutes} from '@/scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("blog");
}

const { lang, slug } = Astro.params;
const page = Astro.props;
const formattedDate = page.data.pubDate.toLocaleString(lang);
const { Content } = await render(page);
---
<ItemLayout_blog frontmatter={page.data}>
  <Content />
</ItemLayout_blog>