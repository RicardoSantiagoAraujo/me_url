---
import { render } from 'astro:content';
import ItemLayout_collectionTemplate from '../../../layouts/collections/ItemLayout_collectionTemplate.astro';
import {generateItemRoutes} from '../../../scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("collectionTemplate");
}

const { lang, slug } = Astro.params;
const page = Astro.props;
const formattedDate = page.data.pubDate.toLocaleString(lang);
const { Content } = await render(page);
---
<ItemLayout_collectionTemplate frontmatter={page.data}>
  <Content />
</ItemLayout_collectionTemplate>