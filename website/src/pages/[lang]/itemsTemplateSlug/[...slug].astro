---
import { render } from 'astro:content';
import MarkdownItemTemplateLayout from '../../../layouts/MarkdownItemTemplateLayout.astro';
import {generateItemRoutes} from '../../../scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("collectionTemplate");
}

const { lang, slug } = Astro.params;
const page = Astro.props;
const formattedDate = page.data.pubDate.toLocaleString(lang);
const { Content } = await render(page);
---
<MarkdownItemTemplateLayout frontmatter={page.data}>
  <Content />
</MarkdownItemTemplateLayout>