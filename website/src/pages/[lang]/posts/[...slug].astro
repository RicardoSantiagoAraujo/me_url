---

import {render } from 'astro:content';
import MarkdownPostLayout from '../../../layouts/collections/MarkdownPostLayout.astro';
import {generateItemRoutes} from '../../../scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("blog");
}

const { lang, slug } = Astro.params;
const page = Astro.props;
const formattedDate = page.data.pubDate.toLocaleString(lang);
const { Content } = await render(page);
---
<MarkdownPostLayout frontmatter={page.data}>
  <Content />
</MarkdownPostLayout>