---
import { render } from 'astro:content';
import ItemLayout_projects from '@/layouts/collections/ItemLayout_projects.astro';
import {generateItemRoutes} from '@/scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("projects");
}

const { lang, slug } = Astro.params;
const page = Astro.props;
const { Content } = await render(page);
---
<ItemLayout_projects frontmatter={page.data}>
  <Content />
</ItemLayout_projects>