---
import {render } from 'astro:content';
import ItemLayout_projects from '@/layouts/collections/ItemLayout_projects.astro';
import {generateItemRoutes} from '@/scripts/dynamicRoutes.ts';
import { collections } from "@/content.config.ts";

export async function getStaticPaths() {
  return generateItemRoutes("projects" as keyof typeof collections);
}

const { lang, slug } = Astro.params;
const page: any = Astro.props;
const { Content } = await render(page);
---
<ItemLayout_projects frontmatter={page.data}>
  <Content />
</ItemLayout_projects>