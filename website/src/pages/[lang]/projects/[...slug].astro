---
import { render } from 'astro:content';
import MarkdownProjectLayout from '../../../layouts/MarkdownProjectLayout.astro';
import {generateItemRoutes} from '../../../scripts/dynamicRoutes.ts'

export async function getStaticPaths() {
  return generateItemRoutes("projects");
}



const { lang, slug } = Astro.params;
const page = Astro.props;
const { Content } = await render(page);
---
<MarkdownProjectLayout frontmatter={page.data}>
  <Content />
</MarkdownProjectLayout>