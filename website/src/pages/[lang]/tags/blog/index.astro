---
import TagsListLayout from "@/layouts/tags/TagsListLayout.astro";
import { collections } from '@/content.config';
import { languages } from "@/i18n/ui";
export const collectionName = "blog"  as keyof typeof collections;


export async function getStaticPaths() {
  // Return an array of route params and props
  return Object.keys(languages).map((lang) => ({
    params: { lang },        // The [lang] param
    props: { lang },         // Pass it as a prop to the page
  }));
}

---
<TagsListLayout collectionNames={[collectionName]}/>