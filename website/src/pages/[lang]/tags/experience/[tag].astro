---
import TaggedItemListLayout from '@/layouts/tags/TaggedItemListLayout.astro';
import {generateTagRoute} from '@/scripts/dynamicRoutes.ts';
import { collections } from '@/content.config';
export const collectionName = "experience"  as keyof typeof collections;
export async function getStaticPaths() {
  return generateTagRoute(collectionName);
}


---

<TaggedItemListLayout {...Astro.props} collectionName={collectionName}/>
