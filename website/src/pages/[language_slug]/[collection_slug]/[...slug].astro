import GenericItemLayout from '@/layouts/collections/GenericItemLayout.astro';
import { getCollection, render } from "astro:content";
import { collections, collectionsMetadata0 } from "@/content.config.ts";
import { languages, defaultLang } from "@/i18n/ui";
import { translateRoute } from '@/i18n/utils';
export const collection_slugs=Object.keys(collections) as (keyof typeof collections)[];
export const language_slugs=Object.keys(languages) as (keyof typeof languages)[];

export async function getStaticPaths() {
  const paths = [];
  for (let collection_slug of collection_slugs) {
    if (!Object.keys(collectionsMetadata0).includes(collection_slug)) {
      throw `The collection name '**${collection_slug}**' is not valid! Available collections: ${Object.keys(
        collectionsMetadata0
      ).join(", ")}.`;
    }

    let allCollectionItems = (await getCollection(collection_slug)) as Array<{
      id: string;
      data: { include?: boolean };
    }>;

    // Filter out excluded items
    allCollectionItems = allCollectionItems.filter((item) => {
      return item.data.include !== false;
    });

    // Order items
    allCollectionItems = allCollectionItems.sort((a, b) => {
      return b.id.localeCompare(a.id, undefined, { numeric: true });
    });

    // Collect paths for all language slugs
    for (let item of allCollectionItems) {
      const [item_language, ...slug] = item.id.split("/");
      for (let language_slug of language_slugs) {
        console.log(language_slugs);
        const translated_collection_slug = translateRoute(
          collection_slug,
          item_language as keyof typeof languages,
          language_slug as keyof typeof languages
        ) as never;
        console.log(
          `collection_slug ${collection_slug} (${item_language}) translated to ${language_slug}: ${translated_collection_slug}`
        );
        paths.push({
          params: {
            collection_slug: translated_collection_slug,
            language_slug,
            slug: slug.join("/") || undefined,
          },
          props: { item },
        });
      }
    }
  }
  console.log(paths);
  return paths;
}

const { language_slug, slug } = Astro.params;
const { item }: any = Astro.props;
const { Content } = await render(item);
