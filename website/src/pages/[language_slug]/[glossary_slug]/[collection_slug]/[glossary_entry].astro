---
import GlossaryMarkedItemListLayout from '@/layouts/glossaries/GlossaryMarkedItemListLayout.astro';
import { collections, glossaries} from '@/content.config';
import { getCollection } from 'astro:content';
import { languages } from "@/i18n/language.config";
export const collection_slugs = Object.keys(collections) as (keyof typeof collections)[];
export const language_slugs = Object.keys(languages);
export const glossary_slugs = Object.keys(glossaries);

export async function getStaticPaths() {
  const paths = [];
  for (const collection_slug of collection_slugs) {
    for (const language_slug of language_slugs) {
      for (const glossary_slug of glossary_slugs) {
        const allItems = await getCollection(collection_slug);
        if ((allItems[0] as any).data[glossary_slug] == undefined){
           continue
          }
        const filteredGlossaryEntries = [
          ...new Set(
            allItems
              .map((item: any) => item.data[glossary_slug])
              .flat()
              .filter((entry) => entry.include !== false)
              .map((entry) => entry.id)
          ),
        ];
        for (const entry of filteredGlossaryEntries) {
          const filteredItems = allItems
          .filter((item: any) => {
            const entries = item.data[glossary_slug].map((t: any) => t.id);
            return entries.includes(entry);
          })
          .filter((item: any) => {
            return item.id.startsWith(`${language_slug}/`) // include only the right language
          })

          paths.push({
            params: { glossary_entry: entry, collection_slug, language_slug, glossary_slug },
            props: { items: filteredItems, collection_slug, language_slug, glossary_slug },
          });
        }
      }
    }
  }
  return paths;
}

const { collection_slug, language_slug, glossary_slug , items} = Astro.props;

---

<GlossaryMarkedItemListLayout {...Astro.props} collectionName={collection_slug} glossaryType={glossary_slug}  />
