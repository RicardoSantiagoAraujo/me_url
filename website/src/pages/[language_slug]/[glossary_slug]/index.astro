---
import GlossaryEntriesListLayout from "@/layouts/glossaries/GlossaryEntriesListLayout.astro";
import {collectionsMetadata, glossaries} from "@/content.config";
const collectionsNamesArray = Object.keys(collectionsMetadata);
import { languages } from "@/i18n/language.config";
export const language_slugs = Object.keys(languages);
export const glossary_slugs = Object.keys(glossaries);
export async function getStaticPaths() {
  // Return an array of route params and props
  const paths = [];
  for (const language_slug of language_slugs) {
    for (const glossary_slug of glossary_slugs) {
      // const translated_collection_slug = translateRoute(
      //     glossary_slug,
      //     defaultLang,
      //     language_slug as keyof typeof languages
      //   );
      paths.push( {
        params: { language_slug, glossary_slug },
        props: { language_slug, glossary_slug },
      });
    }
  }
  return paths;
}

const {language_slug, glossary_slug} = Astro.props;
---
<GlossaryEntriesListLayout glossaryType={glossary_slug} collectionNames={collectionsNamesArray}/>