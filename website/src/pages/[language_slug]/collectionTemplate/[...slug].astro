---
import {render } from 'astro:content';
import ItemLayout_collectionTemplate from '@/layouts/collections/ItemLayout_collectionTemplate.astro';
import {generateCollectionItemRoutes} from '@/scripts/dynamicRoutes.ts';
import { collections } from "@/content.config.ts";

export async function getStaticPaths() {
  return generateCollectionItemRoutes("collectionTemplate" as keyof typeof collections);
}

const { language_slug, slug } = Astro.params;
const page: any = Astro.props;
const { Content } = await render(page);
---
<ItemLayout_collectionTemplate frontmatter={page.data}>
  <Content />
</ItemLayout_collectionTemplate>