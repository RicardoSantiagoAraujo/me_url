---
import {render } from 'astro:content';
import ItemLayout_experience from '@/layouts/collections/ItemLayout_experience.astro';
import {generateCollectionItemRoutes} from '@/scripts/dynamicRoutes.ts';
import { collections } from "@/content.config.ts";

export async function getStaticPaths() {
  return generateCollectionItemRoutes("experience" as keyof typeof collections);
}

const { language_slug, slug } = Astro.params;
const page: any = Astro.props;
const { Content } = await render(page);
---
<ItemLayout_experience frontmatter={page.data}>
  <Content />
</ItemLayout_experience>