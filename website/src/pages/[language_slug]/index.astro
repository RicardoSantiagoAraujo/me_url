---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Greeting from '@/components/Greeting'; ;
import ParallaxImage from '@/components/ParallaxImage.astro';
import myImg from "@/assets/placeholders/placeholder_image.jpg";
import {collectionsMetadata , collections} from '@/content.config';
import { proccessCollectionItems } from '@/scripts/collections';
import { getLangFromUrl, useTranslations , useTranslatedPath, translateRoute, warningMissingSectionName} from '@/i18n/utils';
import {languages, defaultLang} from "@/i18n/language.config";
import { generateCollectionItemRoutes } from '@/scripts/dynamicRoutes';
import GenericItemLink from '@/components/collections/_generic/GenericItemLink.astro';
import GenericList from '@/components/collections/_generic/GenericList.astro';

const collections_list = Object.entries(collectionsMetadata);
export const language_slugs = Object.keys(languages);


export async function getStaticPaths() {
  // Return an array of route params and props
  return language_slugs.map((language_slug) => ({
    params: { language_slug },        // The [language_slug] param
    props: { language_slug },         // Pass it as a prop to the page
  }));
}

const lang = getLangFromUrl(Astro.url);
// const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);



const parallaxEffect = 0.31;
const pageTitle = "Welcome to my Website !";
const pageSubtitle = ""
---
<BaseLayout pageTitle={pageTitle}  pageSubtitle={pageSubtitle}>

  <div class="home-intro">
    Learn more about me <a href={translatePath("about")}>here</a> or check out some of my <a href={translatePath("projects")}>projects</a>.
  </div>

  <section class="home-collections-wrapper">
    <h2>{"Site contents"}</h2>
    <div class="home-collections">
    {collections_list.map(async ([key, val]) =>{
      var route = await generateCollectionItemRoutes(key as keyof typeof collections);
      route = route.filter(item=>item.params.language_slug == lang); // include only current lang
      route = route.filter(item=>item.props.data.include == true); // include only included items
      // sort by specified field
      if (val.orderBy){
        route = route.sort((a, b) => {
          const aValue = a.props.data[val.orderBy as keyof typeof a.props.data]!;
          const bValue = b.props.data[val.orderBy as keyof typeof b.props.data]!;
          if (aValue < bValue) return -1;
          if (aValue > bValue) return 1;
          return 0;
        });
      }
      // Reverse order if descending
      if (val.sortOrder == "desc"){
        route = route.reverse();
      }

      return (
        <div class="collection-container">
          <h3>

            <a href={`/${lang}/${key}`}  data-tooltip={collectionsMetadata[key]?.description}  data-tippy-placement="top"><span class="collection-title">{translateRoute(key,defaultLang,lang)}</span> <span class="collection-item-count">({route.length})</span></a>
          </h3>
          <GenericList collectionName={key} isGenericComponent={true} itemListComponent={"GenericItemLink"} />
        </div>
      );
    })}
    </div>
  </section>


  <!-- <Greeting client:load messages={["Hej", "Hallo", "Hola", "Habari"]} /> -->

  <!-- <ParallaxImage image={myImg} parallaxEffect={parallaxEffect}>
    Parallax Text
  </ParallaxImage> -->


</BaseLayout>



<style lang="scss">

.home-collections {
  .collection-container {
    opacity: 0;
  }

  // Loop only for the nth-child animation delay
  @for $i from 1 through 10 {
    .collection-container:nth-child(#{$i}) {
      animation: fade-in ease-in-out forwards;
      animation-duration: calc(0.3s);
      animation-delay: calc(0.35s* $i);
    }
  }
}


@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

</style>
