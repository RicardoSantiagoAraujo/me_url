--- 
import GlossaryMarkedItemListLayout from '@/layouts/glossaries/GlossaryMarkedItemListLayout.astro';
import { collections } from '@/content.config';
import { getCollection } from 'astro:content';
import { languages } from "@/i18n/ui";
export const collection_slugs = Object.keys(collections) as (keyof typeof collections)[];
export const language_slugs = Object.keys(languages);
export async function getStaticPaths() {
  const paths = [];
  for (const collection_slug of collection_slugs) {
    const allItems = await getCollection(collection_slug);
    const filteredGlossaryEntries = [
      ...new Set(
        allItems
          .map((item: any) => item.data.tags)
          .flat()
          .filter((entry) => entry.include !== false)
          .map((entry) => entry.id)
      ),
    ];
    for (const language_slug of language_slugs) {
      for (const entry of filteredGlossaryEntries) {
        const filteredItems = allItems
        .filter((item: any) => {
          const entries = item.data.tags.map((t: any) => t.id);
          return entries.includes(entry);
        })
        .filter((item: any) => {
          return item.id.startsWith(`${language_slug}/`) // include only the right language
        })

        paths.push({
          params: { glossaryEntry: entry, collection_slug, language_slug },
          props: { items: filteredItems, collection_slug, language_slug },
        });
      }
    }
  }
  return paths;
}

const { collection_slug, language_slug } = Astro.props;

---
<GlossaryMarkedItemListLayout {...Astro.props} collectionName={collection_slug} glossaryType={"tags"}  />
