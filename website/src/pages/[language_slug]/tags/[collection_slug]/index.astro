---
import TagsListLayout from "@/layouts/tags/TagsListLayout.astro";
import { collections } from '@/content.config';
import { languages } from "@/i18n/ui";  
export const collection_slugs = Object.keys(collections);
export const language_slugs = Object.keys(languages);

export async function getStaticPaths() {
  // Return an array of route params and props
  const paths = [];
  for (const language_slug of language_slugs) {
    for (const collection_slug of collection_slugs) {
      paths.push( {
        params: { language_slug, collection_slug },
        props: { language_slug, collection_slug },
      });
    }
  } 
  return paths;
}
const { collection_slug, language_slug } = Astro.props;
---
collection_slug: {collection_slug}
<!-- <TagsListLayout collectionNames={[collection_slug]}/> -->