---
import GlossaryEntriesListLayout from "@/layouts/glossaries/GlossaryEntriesListLayout.astro";
import {collectionsMetadata} from "@/content.config";
const collectionsNamesArray = Object.keys(collectionsMetadata);
import { languages } from "@/i18n/ui";
export const language_slugs = Object.keys(languages);
export async function getStaticPaths() {
  // Return an array of route params and props
  return language_slugs.map((language_slug) => ({
    params: { language_slug },        // The [language_slug] param
    props: { language_slug },         // Pass it as a prop to the page
  }));
}
---
<GlossaryEntriesListLayout glossaryType="fields" collectionNames={collectionsNamesArray}/>