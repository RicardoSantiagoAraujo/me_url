---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generalParameters as gp} from '../../data/_general';
import { calculateAge, formatWordList } from '../../scripts/utils'; 
import Figure from '@/components/figure/Figure.astro';
import Accordion from '../../components/Accordion.astro';
const pageTitle = "About me";

const skillColor = "navy";
const fontWeight = "bold";
const textCase = "uppercase";

const aboutFigure = {
  url: gp.portrait,
  alt: "About me portrait",
  title: "About me",
  caption: `A photo of me, ${gp.name}.`
}
---

<BaseLayout pageTitle={pageTitle}>
    <style  is:global define:vars={{skillColor, fontWeight, textCase}}>
        h1 {
          color: purple;
          font-size: 3rem;
        }
        .tech {
          color: var(--skillColor);
          font-weight: var(--fontWeight);
          text-transform: var(--textCase);
        }
      </style>

    <Accordion title="About me">
      <div class="about__container">
        <div class="about__container__left">
          <p>
          <span>Hello! My name is {gp.name} {gp.surname}.</span>
          <span>I am {gp.nationality} and {calculateAge(gp.birthYear,gp.birthMonth,gp.birthDay)} years old.</span>
          </p>
          {
            gp.hobbies.length > 0 &&
            <p>Some of my hobbies are {formatWordList(gp.hobbies)}. </p>
          }
          { gp.cvLink &&
            <p>You can download my CV as a pdf file <a href={gp.cvLink} target="_blank" rel="noopener noreferrer">here</a>.</p>
          }
        </div>
        <div class="about__container__right">
          <div class ="portrait" style="max-width: 300px; margin: 20px 0;">
          <Figure imageData={aboutFigure}  showCaption={false} allowZoom={false}/>
          </div>
        </div>
      </div>
    </Accordion>


    <Accordion title="My techstack">
      {Object.values(gp.techstack).length > 0 &&
        <p>Here are some tools in tech that I use:</p>
        <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; list-style-type: none; padding: 0;">
        {Object.values(gp.techstack).map((tool) => <li class="tech">{tool.name}</li>)}
        </ul>
      }
    </Accordion>



</BaseLayout>