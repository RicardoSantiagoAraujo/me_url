---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GenericList from "@/components/collections/_generic/GenericList.astro";
const pageTitle = "My Collection Example";
---
<BaseLayout pageTitle={pageTitle}>
  <p>This is an example of a collection list based on the collection template you can use as a basis for your own custom collections.</p>
  <GenericList listItemComponent="CollectionTemplateLink" collectionName="collectionTemplate"/>

</BaseLayout>