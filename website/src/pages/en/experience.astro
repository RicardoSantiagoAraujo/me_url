---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GenericCardList from "@/components/collections/_generic/GenericCardList.astro";
import { collectionsMetadata } from "@/content.config";
const pageTitle = "";
const collectionName : string = "experience";
const collectionMetadata = collectionsMetadata[collectionName as keyof typeof collectionsMetadata];
---
<BaseLayout pageTitle={pageTitle}>

  <p>Here is my professional experience.</p>

  <GenericCardList collectionName={collectionName} itemListComponent={collectionMetadata.itemListComponent}  orderBy={collectionMetadata.orderBy} sortOrder = {collectionMetadata.sortOrder} />

</BaseLayout>