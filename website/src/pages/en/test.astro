  <script type="module">
    console.log("TEST");
    import { gsap } from "/src/scripts/animation/init.ts";

      gsap.utils.toArray<HTMLElement>(".animate-target").forEach((el, i) => {

          console.log(`Animating element ${i}`, el);
          gsap.set(el, { opacity: 0, y: 50 });
          gsap.to(el, {
              scrollTrigger: {
              trigger: el,
              start: "top 80%",
              toggleActions: "play reverse play reverse",
            //   scrub: true, // animation follows scroll position
              },
              opacity: 1,
              y: 0,
              duration: 0.8,
              delay:   0.4,
              ease: "power3.out",

              onComplete: () => {
                  console.log(`Animation completed for element ${i}`);
              },
          });
      });

  </script>

  <style>
    .animate-target {
        margin-bottom: 2rem;
        height: 50vh;
        background-color: rgba(95, 158, 160, 0.237);
    }
    .animate-target:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }
    </style>
