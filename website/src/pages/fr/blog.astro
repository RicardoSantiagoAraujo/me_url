---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { getLangFromUrl } from "../../i18n/utils";

const pageTitle = "My Blog";
const allitems = await getCollection("blog");
const lang = getLangFromUrl(Astro.url);
---
<BaseLayout pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>
  <ul>
    {
      allitems.map((item) => {
        const fixedUrl = "/" + item.id.replace("/", '/posts/'); // fix the URL to match the expected format
        const itemLang = item.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        // const itemLang = item.id.split('/')[0];
        return <BlogPost url={fixedUrl} title={item.data.title} />
      })
    }
  </ul>
</BaseLayout>