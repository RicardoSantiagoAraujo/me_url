---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectLink from "../../components/ProjectLink.astro";
import { getLangFromUrl } from "../../i18n/utils";

const pageTitle = "My Collection Example";
const allItems = await getCollection("collectionTemplate"); // Adjusted to match the collection name
const lang = getLangFromUrl(Astro.url);
---
<BaseLayout pageTitle={pageTitle}>
  <p>This are projects I have worked on.</p>
  <ul>
    {
      allItems.map((item) => {
        const fixedUrl = "/" + item.id.replace("/", '/itemsTemplateSlug/'); // fix the URL to match the expected format
        const itemLang = item.id.split('/')[0];
        if (itemLang !== lang) {
          return null; // Skip items that don't match the current language
        }
        // const itemLang = item.id.split('/')[0];
        return <ProjectLink url={fixedUrl} title={item.data.title} />
      })
    }
  </ul>
</BaseLayout>