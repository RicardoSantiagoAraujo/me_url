---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {generateTagRoute} from '@/scripts/dynamicRoutes';
export async function getStaticPaths() {
  return generateTagRoute("blog");
}
import GenericList from '@/components/collections/_generic/GenericList.astro';

const { tag } = Astro.params;

const { items } = Astro.props;
---
<BaseLayout pageTitle={tag}>

  <p>Posts tagged with {tag}</p>
  <GenericList listItemComponent="BlogPostLink" collectionName="blog" items={items}/>

</BaseLayout>