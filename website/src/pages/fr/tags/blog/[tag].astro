---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {generateTagRoute} from '../../../../scripts/dynamicRoutes.ts';

export async function getStaticPaths() {
  return generateTagRoute("blog");
}
import GenericList from '../../../../components/collection/_generic/GenericList.astro';

const { tag } = Astro.params;
// console.log(items);
---
<BaseLayout pageTitle={tag}>
  <p>Posts tagged with {tag}</p>
  <GenericList listItemComponent="BlogPostLink" collectionName="blog"/>
</BaseLayout>