---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {generateTagRoute} from '../../../../scripts/dynamicRoutes.ts';
export async function getStaticPaths() {
  return generateTagRoute("experience");
}
import GenericCardList from '../../../../components/collections/_generic/GenericCardList.astro';

const { tag } = Astro.params;
---
<BaseLayout pageTitle={tag}>
  <p>Experience tagged with {tag}</p>
  <GenericCardList listItemComponent="ExperienceCard" collectionName="experience" orderBy={null} sortOrder = "desc"/>
</BaseLayout>